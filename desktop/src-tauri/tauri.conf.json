{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quantara",
  "version": "0.1.0",
  "identifier": "app.quantara.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Quantara",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "copyright": "Quantara",
    "category": "Finance",
    "shortDescription": "Gestion de budget",
    "longDescription": "Gestion de budget personnelle : revenus, charges, trésorerie, objectifs et fonds d'urgence. Les données restent sur la machine."
  }
}
